<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<add key="defaultPushSource" value="https://api.nuget.org/v3/index.json" />
	</config>
	<!--
		minPublishAgeHours is what the .NET 11 SDK writes for the `dotnet nuget add source`
		min-publish-age-hours option. It only affects version selection for `dotnet package
		add/update` and floating references, so the repository's pinned versions restore normally
		while a freshly published, not-yet-reviewed version cannot be picked up by accident.
	-->
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="24" />
	</packageSources>
</configuration>
