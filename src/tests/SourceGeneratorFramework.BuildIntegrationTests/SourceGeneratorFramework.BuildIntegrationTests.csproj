<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Builds the checked-in Purview.ComponentClosureFixture with the real MSBuild toolchain and
		inspects the resulting metadata. It intentionally does not reference the fixture projects so
		the fixture's on-disk shape stays independent of this assembly's project graph.

		The test framework packages (TUnit) are supplied automatically by Purview.BuildSdk for test
		projects, so they must not be declared here.

		System.Reflection.Metadata is in the shared framework for net10.0/net11.0, so it is referenced
		through the targeting pack rather than as a package. Declaring the package here produced
		NU1510 ("automatically available ... does not need to be referenced explicitly").
	-->
</Project>
