<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The tool targets the .NET 10 floor; running the suite on net11.0 proves latest-major
		     roll-forward and the .NET 11 runtime path, not just the TFM it was built for. -->
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Mono.Cecil" />
	</ItemGroup>

	<ItemGroup>
		<!-- Locates the real framework assembly so a merge can be asserted end-to-end. -->
		<ProjectReference Include="..\..\src\SourceGeneratorFramework\SourceGeneratorFramework.csproj" />
	</ItemGroup>
</Project>
