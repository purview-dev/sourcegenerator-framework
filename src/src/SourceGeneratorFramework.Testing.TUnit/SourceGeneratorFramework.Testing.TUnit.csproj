<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="Agent Skills">
		<!-- Authored at the repository root in skills/; packed into .agents/skills/ so consumers
		     still receive them through the mirror. See src/Directory.Build.targets. -->
		<PurviewSkillsToPack>tunit-test-authoring</PurviewSkillsToPack>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;$(TestingTargetFrameworks)</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<AssemblyName>$(RootNamespace)</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SourceGeneratorFramework.Testing\SourceGeneratorFramework.Testing.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="TUnit.Core" />
		<PackageReference Include="TUnit.Assertions" />
	</ItemGroup>
</Project>
