<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<IsRoslynComponent>false</IsRoslynComponent>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<!--
			This project is the compile-time framework library rather than a Roslyn component itself.
			The built framework assembly ships in lib/ so consumers can compile generators against it,
			and the analyzers/ folder carries self-contained generator + analyzer assemblies. PDBs must only be
			delivered through the .snupkg, so symbols are explicitly enabled.
		-->
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- The repo's pack validation requires PDBs to be delivered only through the .snupkg, so the
		     analyzer PDB must not ship inside the .nupkg under analyzers/dotnet/cs. -->
		<PurviewPackAnalyzerPdb>false</PurviewPackAnalyzerPdb>
		<PurviewEmbedSourceGeneratorFramework>false</PurviewEmbedSourceGeneratorFramework>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BuildAndPackBundledAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
	</ItemGroup>

	<ItemGroup>
		<!-- The shared types were internal to the retired Shared assembly and visible to these
		     assemblies via InternalsVisibleTo; they are internal to this assembly now. -->
		<InternalsVisibleTo Include="Purview.SourceGeneratorFramework.Generators" />
		<InternalsVisibleTo Include="Purview.SourceGeneratorFramework.SourceGeneratorShared.UnitTests" />
	</ItemGroup>

	<!--
		The SourceGeneratorShared sources compile into this assembly so consumers receive a single
		Purview.SourceGeneratorFramework.dll instead of a separate
		Purview.SourceGeneratorFramework.Shared.dll.
	-->
	<Import Project="..\SourceGeneratorShared\SourceGeneratorShared.Link.targets" />

	<ItemGroup Label="Packaged documentation">
		<!--
			The packaged README links Packaging.md; the wiki page is the single source of truth and
			must ship so the relative link resolves inside the package.
		-->
		<None Include="..\..\..\docs\wiki\Packaging.md" Link="Sdk\Packaging.md" Pack="true" Visible="true" />
	</ItemGroup>

	<!--
		The generator, analyzer, and code-fix assemblies were previously consumed as analyzer
		ProjectReferences. They now reference this assembly for the shared types, which would form
		a project-reference cycle, so they are built and packed into analyzers/dotnet/cs here.
	-->
	<Target
		Name="BuildAndPackBundledAnalyzerAssemblies"
		Label="Builds and packs the bundled generator/analyzer/code-fix assemblies."
	>
		<MSBuild
			Projects="..\SourceGeneratorFramework.Generators\SourceGeneratorFramework.Generators.csproj;..\SourceGeneratorFramework.Analyzers\SourceGeneratorFramework.Analyzers.csproj;..\SourceGeneratorFramework.CodeFixers\SourceGeneratorFramework.CodeFixers.csproj"
			Targets="GetPurviewMergedAnalyzerFile"
			Properties="Configuration=$(Configuration)"
			BuildInParallel="false"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewBundledAnalyzerFile" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile
				Include="@(_PurviewBundledAnalyzerFile)"
				Condition="Exists('%(_PurviewBundledAnalyzerFile.Identity)') AND '%(_PurviewBundledAnalyzerFile.Filename)%(_PurviewBundledAnalyzerFile.Extension)' != 'Purview.SourceGeneratorFramework.dll'"
			>
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
			<_PurviewMergeToolPackageFile Include="..\SourceGeneratorFramework.MergeTool\bin\$(Configuration)\$(MergeToolTFM)\*.dll;..\SourceGeneratorFramework.MergeTool\bin\$(Configuration)\$(MergeToolTFM)\*.json">
				<PackagePath>tools/$(MergeToolTFM)/%(_PurviewMergeToolPackageFile.Filename)%(_PurviewMergeToolPackageFile.Extension)</PackagePath>
			</_PurviewMergeToolPackageFile>
			<TfmSpecificPackageFile Include="@(_PurviewMergeToolPackageFile)" />
		</ItemGroup>
	</Target>
</Project>
