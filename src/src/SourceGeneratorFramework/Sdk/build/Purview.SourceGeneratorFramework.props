<Project>
	<PropertyGroup>
		<PurviewSourceGeneratorFrameworkValidateCodeWriterScopes
			Condition="'$(PurviewSourceGeneratorFrameworkValidateCodeWriterScopes)' == ''"
			>false</PurviewSourceGeneratorFrameworkValidateCodeWriterScopes>
		<PurviewSourceGeneratorFrameworkEnableLogging
			Condition="'$(PurviewSourceGeneratorFrameworkEnableLogging)' == ''"
			>false</PurviewSourceGeneratorFrameworkEnableLogging>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="PurviewSourceGeneratorFrameworkValidateCodeWriterScopes">
			<Description>Throws when generated source is materialized while CodeWriter scopes remain undisposed.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewSourceGeneratorFrameworkEnableLogging">
			<Description>Enables framework source-generator logging when a matching sink is registered.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewSourceGeneratorFrameworkLoggingSessionId">
			<Description>Identifies the registered sink for an isolated source-generator logging session.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewSourceGeneratorFrameworkLanguageVersion">
			<Description>Carries the consuming project's LangVersion so generators can gate emitted features.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsRoslynComponent">
			<Description>True when the project is a Roslyn component (source generator, analyzer, or code fix).</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="IsPackable">
			<Description>True when the project produces its own NuGet package.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewEmbedSourceGeneratorFramework">
			<Description>True when the framework implementation is merged into the Roslyn component.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles">
			<Description>True when GetSourceGeneratorAnalyzerFiles returns a merged, self-contained component.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="PurviewSourceGeneratorFrameworkAnalyzerValidation">
			<Description>False to opt out of PSGFR39 self-contained analyzer validation.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Purview.SourceGeneratorFramework" />
		<Using Include="Purview.SourceGeneratorFramework.Helpers" />
		<Using Include="Purview.SourceGeneratorFramework.Logging" />
		<Using
			Condition="$(DisablePurviewAttributeDataSourceGenerator) != 'true'"
			Include="Purview.SourceGeneratorFramework.Generators"
		/>
		<Using Include="Purview.SourceGeneratorFramework.XmlCommentWriter" Static="true" />
	</ItemGroup>

	<ItemGroup>
		<Using
			Include="Purview.SourceGeneratorFramework.GenerationContext&lt;Purview.SourceGeneratorFramework.EmptyCapabilities&gt;"
			Alias="GeneratorContext"
		/>
	</ItemGroup>
</Project>
