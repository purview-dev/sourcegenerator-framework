<Project>
	<PropertyGroup>
		<_PurviewSourceGeneratorFrameworkAssembly Condition="'$(_PurviewSourceGeneratorFrameworkAssembly)' == ''"
			>$(MSBuildThisFileDirectory)..\lib\netstandard2.0\Purview.SourceGeneratorFramework.dll</_PurviewSourceGeneratorFrameworkAssembly>
		<_PurviewSourceGeneratorFrameworkMergeTool Condition="'$(_PurviewSourceGeneratorFrameworkMergeTool)' == ''"
			>$(MSBuildThisFileDirectory)..\tools\net10.0\Purview.SourceGeneratorFramework.MergeTool.dll</_PurviewSourceGeneratorFrameworkMergeTool>
		<PurviewEmbedSourceGeneratorFramework
			Condition="'$(PurviewEmbedSourceGeneratorFramework)' == '' AND '$(IsRoslynComponent)' == 'true'"
			>true</PurviewEmbedSourceGeneratorFramework>
		<PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles
			Condition="'$(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles)' == ''"
			>true</PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles>
		<ProduceReferenceAssembly Condition="'$(ProduceReferenceAssembly)' == '' AND '$(IsRoslynComponent)' == 'true'"
			>true</ProduceReferenceAssembly>
	</PropertyGroup>

	<!--
		Resolves the framework assembly that a component references. Component projects override
		_PurviewSourceGeneratorFrameworkAssembly from $(TargetDir), which is empty at static
		evaluation, so the stored value can be a bare relative filename. This target re-resolves the
		definitive path at execution time: the framework package's lib/ for package consumers,
		otherwise the copy beside this component's output, otherwise the resolved copy-local path.
	-->
	<Target
		Name="_PurviewResolveSourceGeneratorFrameworkAssembly"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true'"
	>
		<PropertyGroup>
			<_PurviewSourceGeneratorFrameworkAssemblyFullPath>$([System.IO.Path]::GetFullPath('$(_PurviewSourceGeneratorFrameworkAssembly)'))</_PurviewSourceGeneratorFrameworkAssemblyFullPath>
			<_PurviewResolvedFrameworkAssembly Condition="Exists('$(_PurviewSourceGeneratorFrameworkAssemblyFullPath)')"
				>$(_PurviewSourceGeneratorFrameworkAssemblyFullPath)</_PurviewResolvedFrameworkAssembly>
			<_PurviewResolvedFrameworkAssembly
				Condition="'$(_PurviewResolvedFrameworkAssembly)' == '' AND Exists('$(TargetDir)Purview.SourceGeneratorFramework.dll')"
				>$(TargetDir)Purview.SourceGeneratorFramework.dll</_PurviewResolvedFrameworkAssembly>
		</PropertyGroup>
		<ItemGroup Condition="'$(_PurviewResolvedFrameworkAssembly)' == ''">
			<_PurviewSourceGeneratorFrameworkReference
				Include="@(ReferenceCopyLocalPaths)"
				Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Purview.SourceGeneratorFramework.dll'"
			/>
		</ItemGroup>
		<PropertyGroup Condition="'$(_PurviewResolvedFrameworkAssembly)' == ''">
			<_PurviewResolvedFrameworkAssembly>@(_PurviewSourceGeneratorFrameworkReference->'%(FullPath)')</_PurviewResolvedFrameworkAssembly>
		</PropertyGroup>
	</Target>

	<!--
		Resolves the framework assembly early enough for content assignment. This deliberately does
		not depend on ResolveAssemblyReferences (which runs after AssignTargetPaths): the framework
		package lib path and the component's explicit override are both available at evaluation time.
	-->
	<Target Name="_PurviewResolveFrameworkAssemblyForOutputCopy">
		<PropertyGroup>
			<_PurviewFrameworkOutputCopyAssembly>$([System.IO.Path]::GetFullPath('$(_PurviewSourceGeneratorFrameworkAssembly)'))</_PurviewFrameworkOutputCopyAssembly>
		</PropertyGroup>
	</Target>

	<!--
		A merged component's analyzer artifact is self-contained, but its bin output is not: the
		unmerged bin assembly references Purview.SourceGeneratorFramework, and package consumers do
		not copy the framework's lib asset to output (netstandard2.0 libraries do not copy package
		lib assets). A dependent component that references this component normally resolves the
		unmerged bin copy at runtime, so the framework assembly must sit beside it.

		Declare the resolved framework assembly as copy-to-output content. Content with
		CopyToOutputDirectory flows transitively through ProjectReference, so a dependent component's
		bin folder becomes self-sufficient without any consumer-side configuration, while the merged
		analyzer artifact stays the only thing returned to Roslyn.

		This is deliberately *not* a SourceGeneratorRuntimeDependency: that item feeds the analyzer
		closure and the package, where the loose framework DLL must never appear.
	-->
	<Target
		Name="DeclarePurviewFrameworkOutputCopy"
		BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems"
		DependsOnTargets="_PurviewResolveFrameworkAssemblyForOutputCopy"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles)' == 'true'"
		Label="Copies the framework assembly beside the component's bin output."
	>
		<ItemGroup Condition="'$(_PurviewFrameworkOutputCopyAssembly)' != '' AND Exists('$(_PurviewFrameworkOutputCopyAssembly)')">
			<None
				Include="$(_PurviewFrameworkOutputCopyAssembly)"
				Link="Purview.SourceGeneratorFramework.dll"
				TargetPath="Purview.SourceGeneratorFramework.dll"
				CopyToOutputDirectory="PreserveNewest"
				Pack="false"
				Visible="false"
			/>
		</ItemGroup>
	</Target>

	<!--
		Unmerged analyzer consumption. When a project references this component as an analyzer
		(OutputItemType="Analyzer"), GetSourceGeneratorAnalyzerFiles resolves the unmerged generator
		assembly and the loose framework DLL is returned alongside it so the compiler can load both.
		This keeps the component's own bin output unmerged, which the in-process test harness relies
		on. Components that produce a merged self-contained analyzer
		(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles=true) do not need the loose DLL and
		skip this declaration.

		The runtime dependency is declared statically (using the resolved framework package lib path,
		which exists for package consumers) so the SDK's CopySourceGeneratorRuntimeDependencies target
		can copy it into the component output before GetSourceGeneratorAnalyzerFiles runs. In-repo
		component projects, whose framework assembly is already copied into their output by the
		project reference, are declared later by DeclarePurviewFrameworkRuntimeDependency.
	-->
	<ItemGroup Condition="'$(IsRoslynComponent)' == 'true' AND '$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles)' != 'true' AND Exists('$(_PurviewSourceGeneratorFrameworkAssembly)')">
		<SourceGeneratorRuntimeDependency Include="$(_PurviewSourceGeneratorFrameworkAssembly)">
			<DestinationSubPath>Purview.SourceGeneratorFramework.dll</DestinationSubPath>
		</SourceGeneratorRuntimeDependency>
	</ItemGroup>

	<Target
		Name="DeclarePurviewFrameworkRuntimeDependency"
		BeforeTargets="CopySourceGeneratorRuntimeDependencies;GetSourceGeneratorAnalyzerFiles"
		DependsOnTargets="_PurviewResolveSourceGeneratorFrameworkAssembly"
		Condition="'$(IsRoslynComponent)' == 'true' AND '$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles)' != 'true'"
	>
		<ItemGroup Condition="'@(SourceGeneratorRuntimeDependency)' == ''">
			<SourceGeneratorRuntimeDependency
				Include="$(_PurviewResolvedFrameworkAssembly)"
				Condition="'$(_PurviewResolvedFrameworkAssembly)' != ''"
			>
				<DestinationSubPath>Purview.SourceGeneratorFramework.dll</DestinationSubPath>
			</SourceGeneratorRuntimeDependency>
		</ItemGroup>
	</Target>

	<Target
		Name="BuildPurviewSourceGeneratorFrameworkMergeTool"
		Condition="Exists('$(_PurviewSourceGeneratorFrameworkMergeToolProject)')"
	>
		<MSBuild
			Projects="$(_PurviewSourceGeneratorFrameworkMergeToolProject)"
			Targets="Build"
			Properties="Configuration=$(Configuration);TargetFramework=net10.0"
		/>
	</Target>

	<!--
		Roslyn loads analyzer dependencies into a shared compiler process. Two generators cannot
		safely carry incompatible versions of the same Purview.SourceGeneratorFramework assembly.
		Merge and internalize the framework implementation into each Roslyn component instead,
		leaving the component's own assembly identity as the only compiler-visible output.

		This target produces the merged assembly in the intermediate directory only; it never
		overwrites the component's bin output on its own. The analyzer-files and pack targets copy
		it into place when the component must be consumed or shipped as a self-contained assembly.
	-->
	<Target
		Name="_PurviewMergeSourceGeneratorFramework"
		DependsOnTargets="BuildPurviewSourceGeneratorFrameworkMergeTool;ResolveAssemblyReferences;_PurviewResolveSourceGeneratorFrameworkAssembly"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true'"
	>
		<PropertyGroup>
			<_PurviewMergedComponentDirectory>$(IntermediateOutputPath)purview-merged\</_PurviewMergedComponentDirectory>
			<_PurviewMergedAnalyzerStagingDirectory>$(IntermediateOutputPath)purview-pack\</_PurviewMergedAnalyzerStagingDirectory>
			<!-- Returned to the calling project, so it must be absolute: a relative path would be
			     resolved against the caller's directory when it tests Exists(). -->
			<_PurviewMergedAnalyzerStagingDirectoryFullPath>$([System.IO.Path]::GetFullPath('$(_PurviewMergedAnalyzerStagingDirectory)'))</_PurviewMergedAnalyzerStagingDirectoryFullPath>
		</PropertyGroup>

		<Error
			Condition="'$(_PurviewResolvedFrameworkAssembly)' == '' OR !Exists('$(_PurviewResolvedFrameworkAssembly)')"
			Text="Cannot embed Purview.SourceGeneratorFramework because no framework assembly was resolved (raw value '$(_PurviewSourceGeneratorFrameworkAssembly)')."
		/>
		<Error
			Condition="!Exists('$(_PurviewSourceGeneratorFrameworkMergeTool)')"
			Text="Cannot embed Purview.SourceGeneratorFramework because the merge tool '$(_PurviewSourceGeneratorFrameworkMergeTool)' does not exist."
		/>

		<MakeDir Directories="$(_PurviewMergedComponentDirectory)" />

		<!--
			Content-addressed merged artifact. The tag is a content hash of the merge inputs, so:

			  * a rebuild with identical inputs reuses the existing directory and skips the merge
			    (idempotent across the per-consumer, possibly parallel invocations of
			    GetSourceGeneratorAnalyzerFiles); and
			  * changed inputs select a new directory, so the merge never has to overwrite a merged
			    assembly that a compiler host (csc/VBCSCompiler/Visual Studio) already has loaded.
			    Overwriting it fails on Windows with a sharing violation, which surfaced as MSB3073
			    (merge tool exit code -532462766) and left consumers loading a stale or partially
			    written analyzer - the cause of CS8784 FileNotFoundException at runtime.

			The tag goes in the directory, never the file name: ILRepack derives the merged assembly's
			simple name from the output file name and an analyzer must keep <AssemblyName>.dll.
		-->
		<Exec
			Command="dotnet exec &quot;$(_PurviewSourceGeneratorFrameworkMergeTool)&quot; --tag &quot;$(TargetPath)&quot; &quot;$(_PurviewResolvedFrameworkAssembly)&quot; &quot;$(_PurviewSourceGeneratorFrameworkMergeTool)&quot;"
			ConsoleToMSBuild="true"
			StandardOutputImportance="low"
		>
			<Output TaskParameter="ConsoleOutput" PropertyName="_PurviewMergedComponentTagRaw" />
		</Exec>
		<Error
			Condition="'$(_PurviewMergedComponentTagRaw)' == ''"
			Text="Could not compute the merge content tag for '$(TargetPath)'."
		/>
		<PropertyGroup>
			<_PurviewMergedComponentTag>$([System.String]::Copy('$(_PurviewMergedComponentTagRaw)').Substring(0, 16).Trim())</_PurviewMergedComponentTag>
			<_PurviewMergedComponentTagDirectory>$(_PurviewMergedComponentDirectory)$(_PurviewMergedComponentTag)\</_PurviewMergedComponentTagDirectory>
			<_PurviewMergedComponent>$(_PurviewMergedComponentTagDirectory)$(TargetFileName)</_PurviewMergedComponent>
			<_PurviewMergedComponentPdb>$(_PurviewMergedComponentTagDirectory)$(TargetName).pdb</_PurviewMergedComponentPdb>
		</PropertyGroup>

		<!--
			The tagged directory is created by the merge tool as part of publishing (it renames its
			staging directory into place); creating it here would make that rename fail.
		-->
		<Exec
			Condition="!Exists('$(_PurviewMergedComponent)')"
			Command="dotnet exec &quot;$(_PurviewSourceGeneratorFrameworkMergeTool)&quot; &quot;$(TargetPath)&quot; &quot;$(_PurviewResolvedFrameworkAssembly)&quot; &quot;$(_PurviewMergedComponent)&quot; @(ReferencePath->'&quot;%(FullPath)&quot;', ' ')"
		/>
	</Target>

	<!--
		Copies the content-addressed merged artifact to a stable, plainly named staging file.

		Packages must expose analyzers/dotnet/cs/<AssemblyName>.dll (the framework package's pack
		validation and the SDK's analyzer conventions depend on it), but the merge target deliberately
		never writes that name into the component output. Staging in the intermediate directory keeps
		the packed name stable without ever overwriting a file the compiler host may hold open.
	-->
	<Target
		Name="_PurviewStageMergedAnalyzerFile"
		DependsOnTargets="_PurviewMergeSourceGeneratorFramework"
		Returns="@(_PurviewStagedMergedAnalyzerFile)"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true'"
	>
		<MakeDir Directories="$(_PurviewMergedAnalyzerStagingDirectory)" />
		<Copy
			SourceFiles="$(_PurviewMergedComponent)"
			DestinationFiles="$(_PurviewMergedAnalyzerStagingDirectory)$(TargetFileName)"
			SkipUnchangedFiles="true"
			Condition="Exists('$(_PurviewMergedComponent)')"
		/>
		<Copy
			SourceFiles="$(_PurviewMergedComponentPdb)"
			DestinationFiles="$(_PurviewMergedAnalyzerStagingDirectory)$(TargetName).pdb"
			SkipUnchangedFiles="true"
			Condition="Exists('$(_PurviewMergedComponentPdb)')"
		/>
		<ItemGroup>
			<_PurviewStagedMergedAnalyzerFile
				Include="$(_PurviewMergedAnalyzerStagingDirectoryFullPath)$(TargetFileName)"
				Condition="Exists('$(_PurviewMergedAnalyzerStagingDirectoryFullPath)$(TargetFileName)')"
			/>
		</ItemGroup>
	</Target>

	<!--
		Analyzer-files path: when a project references this component as an analyzer, the component's
		output is normally returned unmerged (with the loose framework DLL) so the in-process test
		harness keeps its shared type identity. When
		PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles is true (the default), GetSourceGeneratorAnalyzerFiles
		returns the self-contained merged assembly instead. The merged assembly is returned from the
		intermediate directory and the component's bin output is left unmerged, so a project
		referencing the component's assembly directly (a test harness, for example) never sees the
		merged assembly's internalized framework types and cannot collide with the framework library.

		GetSourceGeneratorAnalyzerFiles reads @(TargetPathWithTargetPlatformMoniker) in its body, so
		the merged assembly is substituted there at the last moment. This target runs before the
		target's body but after its dependencies (Build;GetTargetPathWithTargetPlatformMoniker) have
		populated the item. GetTargetPath â€” which project references use to resolve the component's
		assembly â€” is unaffected, so referencing projects keep the unmerged bin output.
	-->
	<Target
		Name="EmbedPurviewSourceGeneratorFramework"
		BeforeTargets="GetSourceGeneratorAnalyzerFiles"
		DependsOnTargets="_PurviewMergeSourceGeneratorFramework"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(PurviewMergeSourceGeneratorFrameworkForAnalyzerFiles)' == 'true'"
		Label="Returns a self-contained Roslyn component for analyzer-file resolution."
	>
		<Error
			Condition="!Exists('$(_PurviewMergedComponent)')"
			Text="Purview.SourceGeneratorFramework embedding was requested but the merged component '$(_PurviewMergedComponent)' was not produced."
		/>
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Remove="@(TargetPathWithTargetPlatformMoniker)" />
			<TargetPathWithTargetPlatformMoniker Include="$([System.IO.Path]::GetFullPath('$(_PurviewMergedComponent)'))" />
		</ItemGroup>
	</Target>

	<!--
		Framework-owned pack path: the framework package's bundled analyzer collection calls this to
		receive each component's merged assembly directly from the intermediate directory. The
		component's bin output is untouched, and the loose framework DLL is never packed.
	-->
	<Target
		Name="GetPurviewMergedAnalyzerFile"
		DependsOnTargets="Build;GetTargetPathWithTargetPlatformMoniker;_PurviewStageMergedAnalyzerFile"
		Returns="@(_PurviewMergedAnalyzerFileOutput)"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true'"
	>
		<ItemGroup>
			<_PurviewMergedAnalyzerFileOutput Include="@(_PurviewStagedMergedAnalyzerFile)" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(IsPackable)' == 'true'">
		<TargetsForTfmSpecificContentInPackage
			Condition="!$([System.String]::Copy(';$(TargetsForTfmSpecificContentInPackage);').Contains(';GetPurviewMergedAnalyzerFileForPack;'))"
			>$(TargetsForTfmSpecificContentInPackage);GetPurviewMergedAnalyzerFileForPack</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(IsPackable)' == 'true'">
		<!--
			The SDK's default "packable Roslyn component" asset packs $(TargetPath) (and its PDB).
			For an embedded component that is the unmerged assembly, so suppress it and contribute the
			merged assembly instead (GetPurviewMergedAnalyzerFileForPack).
		-->
		<None Remove="$(TargetPath)" />
		<None Remove="$(TargetDir)$(TargetName).pdb" />
	</ItemGroup>

	<!--
		Also suppress at target time: a component that imports the framework targets from its own
		project body is evaluated before the SDK's targets (Directory.Build.targets is imported last),
		so the evaluation-time removal above cannot see the SDK's analyzer asset in that ordering.
	-->
	<Target
		Name="SuppressPurviewUnmergedAnalyzerPackageAssets"
		BeforeTargets="_GetPackageFiles;_GetTfmSpecificContentForPackage;GenerateNuspec"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(IsPackable)' == 'true'"
	>
		<ItemGroup>
			<None Remove="$(TargetPath)" />
			<None Remove="$(TargetDir)$(TargetName).pdb" />
		</ItemGroup>
	</Target>

	<!--
		Pack-time path: contributes the merged, self-contained component to analyzers/dotnet/cs
		without touching the component's bin output. Mutating $(TargetPath) made the bin shape depend
		on whether "build" or "pack" ran last and left MSBuild's incremental copy state â€” and a
		dependent code-fix component's bin folder â€” inconsistent.
	-->
	<Target
		Name="GetPurviewMergedAnalyzerFileForPack"
		DependsOnTargets="_PurviewStageMergedAnalyzerFile"
		Condition="'$(PurviewEmbedSourceGeneratorFramework)' == 'true' AND '$(IsPackable)' == 'true'"
		Label="Contributes the merged, self-contained component to analyzers/dotnet/cs."
	>
		<ItemGroup>
			<TfmSpecificPackageFile
				Include="@(_PurviewStagedMergedAnalyzerFile)"
				Condition="'@(_PurviewStagedMergedAnalyzerFile)' != ''"
			>
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile
				Include="$(_PurviewMergedAnalyzerStagingDirectoryFullPath)$(TargetName).pdb"
				Condition="'$(PurviewPackAnalyzerPdb)' != 'false' AND Exists('$(_PurviewMergedAnalyzerStagingDirectoryFullPath)$(TargetName).pdb')"
			>
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile
				Include="$(TargetDir)$(TargetName).pdb"
				Condition="'$(PurviewPackAnalyzerPdb)' != 'false' AND !Exists('$(_PurviewMergedAnalyzerStagingDirectoryFullPath)$(TargetName).pdb') AND '$(DebugType)' != 'embedded' AND '$(DebugType)' != 'none' AND Exists('$(TargetDir)$(TargetName).pdb')"
			>
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!--
		Validates that every property this project declares as generator-read
		(<PurviewGeneratorVisibleProperty Include="..." />) is actually compiler-visible: either it is
		a CompilerVisibleProperty item in this build, or this project's own Sdk/build /
		Sdk/buildTransitive assets declare it (so PackageReference consumers receive it). This is the
		build-time guard for a generator that reads build_property.* while being developed inside the
		package repo, where NuGet never imports the project's own buildTransitive assets.
	-->
	<UsingTask
		TaskName="ValidatePurviewGeneratorVisibleProperties"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))"
	>
		<ParameterGroup>
			<Declared ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<CompilerVisible ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<AssetFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
			<ProjectName ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Using Namespace="Microsoft.Build.Framework" />
			<Using Namespace="Microsoft.Build.Utilities" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Framework.dll'))" />
			<Reference Include="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Utilities.Core.dll'))" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					var compilerVisiblePropertyPattern = new Regex(
						"<CompilerVisibleProperty\\s+Include\\s*=\\s*[\"'](?<name>[^\"']+)[\"']",
						RegexOptions.IgnoreCase
					);

					var available = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
					if (CompilerVisible != null)
					{
						foreach (var item in CompilerVisible)
							available.Add(item.ItemSpec);
					}

					if (AssetFiles != null)
					{
						foreach (var file in AssetFiles)
						{
							if (!File.Exists(file.ItemSpec))
								continue;

							string text;
							try
							{
								text = File.ReadAllText(file.ItemSpec);
							}
							catch (Exception)
							{
								continue;
							}

							foreach (Match match in compilerVisiblePropertyPattern.Matches(text))
							{
								var include = match.Groups["name"].Value;
								if (!string.IsNullOrWhiteSpace(include))
									available.Add(include.Trim());
							}
						}
					}

					foreach (var item in Declared)
					{
						if (available.Contains(item.ItemSpec))
							continue;

						Log.LogError(null, "PSGF0003", null, null, 0, 0, 0, 0,
							"The project '{0}' declares that its generator reads the MSBuild property '{1}', but '{1}' is not compiler-visible here: there is no CompilerVisibleProperty item for it and no build/buildTransitive asset declares it. Add <CompilerVisibleProperty Include=\"{1}\" /> to the project's Sdk/build or Sdk/buildTransitive assets (or to the outer package that embeds the generator) so consumers can read build_property.{1}.",
							ProjectName, item.ItemSpec);
					}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target
		Name="ValidatePurviewGeneratorVisibleProperties"
		BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile"
		Condition="'$(PurviewSourceGeneratorFrameworkGeneratorPropertyValidation)' != 'false' AND '@(PurviewGeneratorVisibleProperty)' != ''"
		Label="Validates that generator-read MSBuild properties are compiler-visible (PSGF0003)."
	>
		<ItemGroup>
			<_PurviewGeneratorVisiblePropertyAsset Include="$(MSBuildProjectDirectory)\Sdk\build\**\*.props" />
			<_PurviewGeneratorVisiblePropertyAsset Include="$(MSBuildProjectDirectory)\Sdk\build\**\*.targets" />
			<_PurviewGeneratorVisiblePropertyAsset Include="$(MSBuildProjectDirectory)\Sdk\buildTransitive\**\*.props" />
			<_PurviewGeneratorVisiblePropertyAsset Include="$(MSBuildProjectDirectory)\Sdk\buildTransitive\**\*.targets" />
		</ItemGroup>
		<ValidatePurviewGeneratorVisibleProperties
			Declared="@(PurviewGeneratorVisibleProperty)"
			CompilerVisible="@(CompilerVisibleProperty)"
			AssetFiles="@(_PurviewGeneratorVisiblePropertyAsset)"
			ProjectName="$(MSBuildProjectName)"
		/>
	</Target>

	<!--
		Returns the generator-visible properties the current project declares. BuildSdk (and a package
		that embeds a generator) can consume it to require re-declaration in the outer package.
	-->
	<Target Name="GetPurviewGeneratorVisibleProperties" Returns="@(PurviewGeneratorVisibleProperty)" />
</Project>
